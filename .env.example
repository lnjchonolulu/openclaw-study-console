DATABASE_URL="postgresql://openclaw:openclaw@localhost:5432/openclaw_study"
SESSION_SECRET="replace-with-a-long-random-string"
APP_BASE_URL="http://127.0.0.1:3000"
OPENCLAW_GATEWAY_URL="ws://127.0.0.1:18789"
OPENCLAW_RESPONSES_URL="http://127.0.0.1:18789/v1/responses"
OPENCLAW_GATEWAY_TOKEN=""
INTERNAL_AGENT_ACTION_TOKEN="replace-with-a-long-random-token"
# full: normal CyWorld runtime context. none: diagnostic mode that sends no extra
# CyWorld instructions/context to OpenClaw while keeping CyWorld tools available.
CYWORLD_AGENT_RUNTIME_MODE="full"
# Optional diagnostic flags for CYWORLD_AGENT_RUNTIME_MODE=full. Defaults are on.
# Disable one at a time to identify which auxiliary context is affecting a turn.
CYWORLD_AGENT_INCLUDE_RECENT_CONTEXT="1"
CYWORLD_AGENT_INCLUDE_SELECTIVE_NOTES="1"
CYWORLD_AGENT_INCLUDE_FILES_CONTEXT="1"
# Optional. Include AGENTS.md in OpenClaw conversation session invalidation.
# Default session version tracks USER.md, IDENTITY.md, SOUL.md, and HEARTBEAT.md.
CYWORLD_AGENT_SESSION_INCLUDE_AGENTS_MD="0"
# Optional. Log the sanitized OpenClaw /v1/responses user key used by each turn.
CYWORLD_OPENCLAW_SESSION_DEBUG="0"
LOCAL_FILES_ROOT="/var/lib/openclaw-study/files"
OPENAI_API_KEY=""
DAILY_API_KEY=""
DAILY_WEBHOOK_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:3000/api/integrations/google/callback"
