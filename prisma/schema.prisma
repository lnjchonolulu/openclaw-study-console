generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARTICIPANT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum FileVisibility {
  PRIVATE
  ROOM
  TEAM
}

enum RoomType {
  PERSONAL
  TEAM
  GROUP
}

enum MessageRole {
  USER
  AGENT
  SYSTEM
}

enum RoomMemberRole {
  OWNER
  MEMBER
}

enum RoomAgentRole {
  PRIMARY
  COLLABORATOR
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  CANCELED
  FAILED
}

enum AgentTaskStatus {
  OPEN
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELED
}

enum AgentToolExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AgentTaskEventType {
  USER_REQUEST
  AGENT_DECISION
  HANDOFF_REQUEST
  HANDOFF_RESPONSE
  OUTBOUND_MESSAGE
  SCHEDULED_MESSAGE
  INBOUND_REPLY
  SYSTEM_NOTE
}

enum CalendarEventSource {
  CYWORLD
  GOOGLE
}

enum CalendarInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum IntegrationProvider {
  GOOGLE
}

enum VideoCallStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

enum VideoCallParticipantStatus {
  INVITED
  ACCEPTED
  JOINED
  LEFT
  DECLINED
}

model User {
  id                     String                       @id @default(cuid())
  username               String                       @unique
  passwordHash           String
  displayName            String
  timezone               String                       @default("Asia/Seoul")
  profileConfigJson      Json?
  role                   UserRole                     @default(PARTICIPANT)
  status                 UserStatus                   @default(ACTIVE)
  teamId                 String?
  agentId                String?                      @unique
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  team                   Team?                        @relation(fields: [teamId], references: [id])
  agent                  Agent?
  files                  FileRecord[]
  messages               Message[]
  sessions               Session[]
  ownedRooms             Room[]                       @relation("RoomOwner")
  roomMembers            RoomMember[]
  typingStates           TypingState[]
  scheduledMessages      ScheduledMessage[]
  requestedTasks         AgentTask[]                  @relation("AgentTaskRequester")
  targetTasks            AgentTask[]                  @relation("AgentTaskTargetUser")
  calendarEvents         CalendarEvent[]              @relation("CalendarEventCreator")
  hiddenCalendarEvents   CalendarEventHidden[]
  calendarInvites        CalendarInvitation[]         @relation("CalendarInvitationInvitee")
  sentCalendarInvites    CalendarInvitation[]         @relation("CalendarInvitationInviter")
  calendarTitleOverrides CalendarEventTitleOverride[]
  connectedIntegrations  ExternalIntegration[]
  requestedEmailThreads  EmailThread[]                @relation("EmailThreadRequester")
  relationshipGuidance   AgentRelationshipGuidance[]  @relation("RelationshipTargetUser")
  createdVideoCalls      VideoCall[]                  @relation("VideoCallCreator")
  videoCallParticipants  VideoCallParticipant[]
}

model Team {
  id             String          @id @default(cuid())
  name           String          @unique
  users          User[]
  files          FileRecord[]
  rooms          Room[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Agent {
  id                   String                      @id @default(cuid())
  userId               String                      @unique
  openclawAgentId      String                      @unique
  displayName          String
  workspacePath        String
  profileConfigJson    Json?
  personaSummary       String?
  soulConfigJson       Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  user                 User                        @relation(fields: [userId], references: [id])
  messages             Message[]
  roomAgents           RoomAgent[]
  scheduledMessages    ScheduledMessage[]
  tasks                AgentTask[]                 @relation("AgentTaskOwner")
  handoffTasks         AgentTask[]                 @relation("AgentTaskTargetAgent")
  toolExecutions       AgentToolExecution[]
  turnContexts         AgentTurnContext[]
  emailThreads         EmailThread[]
  relationshipGuidance AgentRelationshipGuidance[]
}

model AgentRelationshipGuidance {
  id                  String   @id @default(cuid())
  agentId             String
  targetUserId        String
  relationshipLabel   String?
  interactionGuidance String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  agent               Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  targetUser          User     @relation("RelationshipTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([agentId, targetUserId])
  @@index([targetUserId])
}

model FileRecord {
  id               String         @id @default(cuid())
  ownerUserId      String?
  teamId           String?
  roomId           String?
  parentId         String?
  systemKey        String?        @unique
  filename         String
  storageKey       String
  mimeType         String?
  isFolder         Boolean        @default(false)
  sizeBytes        Int?
  visibility       FileVisibility @default(PRIVATE)
  sourceType       String
  externalProvider String?
  externalFileId   String?        @unique
  externalUrl      String?
  accessConfigJson Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner            User?          @relation(fields: [ownerUserId], references: [id])
  team             Team?          @relation(fields: [teamId], references: [id])
  room             Room?          @relation(fields: [roomId], references: [id])
  parent           FileRecord?    @relation("FileRecordChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children         FileRecord[]   @relation("FileRecordChildren")

  @@index([parentId])
}

model Room {
  id                String             @id @default(cuid())
  type              RoomType
  name              String             @default("Untitled room")
  purpose           String?
  defaultReportMode String             @default("CHANNEL")
  teamId            String?
  ownerUserId       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  team              Team?              @relation(fields: [teamId], references: [id])
  owner             User?              @relation("RoomOwner", fields: [ownerUserId], references: [id])
  messages          Message[]
  files             FileRecord[]
  members           RoomMember[]
  agents            RoomAgent[]
  typingStates      TypingState[]
  scheduledMessages ScheduledMessage[]
  agentTasks        AgentTask[]
  emailThreads      EmailThread[]      @relation("EmailThreadSourceRoom")
  teamAgentChains   TeamAgentChain[]

  @@index([ownerUserId, type])
  @@index([teamId, type])
}

model Message {
  id               String      @id @default(cuid())
  roomId           String
  userId           String?
  agentId          String?
  taskId           String?
  replyToMessageId String?
  role             MessageRole
  content          String
  attachmentsJson  Json?
  createdAt        DateTime    @default(now())
  room             Room        @relation(fields: [roomId], references: [id])
  user             User?       @relation(fields: [userId], references: [id])
  agent            Agent?      @relation(fields: [agentId], references: [openclawAgentId])
  task             AgentTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  replyToMessage   Message?    @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]   @relation("MessageReplies")

  @@index([taskId, createdAt])
  @@index([replyToMessageId])
}

model ScheduledMessage {
  id        String                 @id @default(cuid())
  roomId    String
  agentId   String
  toUserId  String
  taskId    String?
  content   String
  deliverAt DateTime
  status    ScheduledMessageStatus @default(PENDING)
  error     String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  room      Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent     Agent                  @relation(fields: [agentId], references: [openclawAgentId])
  toUser    User                   @relation(fields: [toUserId], references: [id], onDelete: Cascade)
  task      AgentTask?             @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([status, deliverAt])
  @@index([toUserId])
  @@index([agentId])
  @@index([taskId, deliverAt])
}

model AgentTask {
  id                String               @id @default(cuid())
  agentId           String
  targetAgentId     String?
  parentTaskId      String?
  requesterUserId   String
  targetUserId      String?
  sourceRoomId      String?
  status            AgentTaskStatus      @default(OPEN)
  kind              String
  title             String
  objective         String
  resultSummary     String?
  nextReviewAt      DateTime?
  reviewLeaseUntil  DateTime?
  lastReviewedAt    DateTime?
  reviewCount       Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  agent             Agent                @relation("AgentTaskOwner", fields: [agentId], references: [openclawAgentId], onDelete: Cascade)
  targetAgent       Agent?               @relation("AgentTaskTargetAgent", fields: [targetAgentId], references: [openclawAgentId], onDelete: SetNull)
  parentTask        AgentTask?           @relation("AgentTaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks        AgentTask[]          @relation("AgentTaskChildren")
  requester         User                 @relation("AgentTaskRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  targetUser        User?                @relation("AgentTaskTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  sourceRoom        Room?                @relation(fields: [sourceRoomId], references: [id], onDelete: SetNull)
  messages          Message[]
  scheduledMessages ScheduledMessage[]
  events            AgentTaskEvent[]
  toolExecutions    AgentToolExecution[]
  emailThreads      EmailThread[]

  @@index([agentId, status])
  @@index([targetAgentId, status])
  @@index([parentTaskId])
  @@index([requesterUserId, status])
  @@index([targetUserId, status])
  @@index([status, nextReviewAt])
}

model AgentToolExecution {
  id             String                   @id @default(cuid())
  idempotencyKey String                   @unique
  callId         String
  taskId         String?
  actingAgentId  String
  toolName       String
  status         AgentToolExecutionStatus @default(RUNNING)
  resultText     String?
  error          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  task           AgentTask?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actingAgent    Agent                    @relation(fields: [actingAgentId], references: [openclawAgentId], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actingAgentId, createdAt])
  @@index([status, updatedAt])
}

model AgentTurnContext {
  id                 String   @id @default(cuid())
  agentId            String
  currentHumanUserId String?
  requesterUserId    String?
  sourceRoomId       String?
  taskId             String?
  triggerType        String?
  objective          String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  agent              Agent    @relation(fields: [agentId], references: [openclawAgentId], onDelete: Cascade)

  @@index([agentId, expiresAt])
  @@index([sourceRoomId, createdAt])
}

model EmailThread {
  id                 String         @id @default(cuid())
  agentId            String
  requesterUserId    String
  sourceRoomId       String?
  taskId             String?
  gmailThreadId      String         @unique
  lastGmailMessageId String?
  subject            String
  to                 String
  cc                 String?
  status             String         @default("OPEN")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  agent              Agent          @relation(fields: [agentId], references: [openclawAgentId], onDelete: Cascade)
  requester          User           @relation("EmailThreadRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  sourceRoom         Room?          @relation("EmailThreadSourceRoom", fields: [sourceRoomId], references: [id], onDelete: SetNull)
  task               AgentTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  messages           EmailMessage[]

  @@index([agentId, status])
  @@index([requesterUserId, status])
  @@index([sourceRoomId])
  @@index([taskId])
}

model EmailMessage {
  id             String      @id @default(cuid())
  emailThreadId  String
  gmailMessageId String      @unique
  direction      String
  from           String?
  to             String?
  cc             String?
  subject        String?
  snippet        String?
  body           String?
  receivedAt     DateTime?
  payloadJson    Json?
  createdAt      DateTime    @default(now())
  emailThread    EmailThread @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)

  @@index([emailThreadId, createdAt])
}

model AgentTaskEvent {
  id        String             @id @default(cuid())
  taskId    String
  type      AgentTaskEventType
  summary   String
  payload   Json?
  createdAt DateTime           @default(now())
  task      AgentTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model RoomMember {
  roomId          String
  userId          String
  role            RoomMemberRole @default(MEMBER)
  canManageRoom   Boolean        @default(false)
  canManageAgents Boolean        @default(false)
  canShareFiles   Boolean        @default(true)
  lastReadAt      DateTime       @default(now())
  joinedAt        DateTime       @default(now())
  room            Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

model TypingState {
  roomId    String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([expiresAt])
}

model RoomAgent {
  roomId            String
  agentId           String
  role              RoomAgentRole @default(COLLABORATOR)
  roleNote          String?
  canRespond        Boolean       @default(true)
  canUseFiles       Boolean       @default(true)
  canBeMentioned    Boolean       @default(true)
  lastSeenMessageId String?
  lastInvokedAt     DateTime?
  lastSpokeAt       DateTime?
  mutedUntil        DateTime?
  joinedAt          DateTime      @default(now())
  room              Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent             Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([roomId, agentId])
}

model AppSetting {
  key       String   @id
  valueJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamAgentChain {
  id                 String               @id @default(cuid())
  roomId             String
  rootMessageId      String
  lastMessageId      String?
  status             String               @default("ACTIVE")
  turnCount          Int                  @default(0)
  openItemsJson      Json?
  lastSpeakerAgentId String?
  stopReason         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  room               Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  turns              TeamAgentChainTurn[]

  @@index([roomId, status, updatedAt])
  @@index([rootMessageId])
  @@index([lastMessageId])
}

model TeamAgentChainTurn {
  id               String         @id @default(cuid())
  chainId          String
  agentId          String
  messageId        String?
  decision         String
  contributionType String?
  newValue         String?
  openItem         String?
  reason           String?
  arbiterVerdict   String?
  createdAt        DateTime       @default(now())
  chain            TeamAgentChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@index([chainId, createdAt])
  @@index([chainId, agentId, createdAt])
  @@index([messageId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id               String                       @id @default(cuid())
  teamId           String?
  createdByUserId  String?
  title            String
  description      String?
  location         String?
  startAt          DateTime
  endAt            DateTime
  allDay           Boolean                      @default(false)
  source           CalendarEventSource          @default(CYWORLD)
  externalProvider String?
  externalEventId  String?
  accessConfigJson Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  team             Team?                        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy        User?                        @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  hiddenForUsers   CalendarEventHidden[]
  invitations      CalendarInvitation[]
  titleOverrides   CalendarEventTitleOverride[]
  videoCall         VideoCall?

  @@index([teamId, startAt])
  @@index([createdByUserId, startAt])
  @@index([source, externalProvider, externalEventId])
}

model CalendarEventHidden {
  eventId   String
  userId    String
  createdAt DateTime      @default(now())
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model CalendarEventTitleOverride {
  id        String        @id @default(cuid())
  eventId   String
  userId    String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model CalendarInvitation {
  id              String                   @id @default(cuid())
  eventId         String
  invitedUserId   String
  invitedByUserId String?
  status          CalendarInvitationStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  event           CalendarEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedUser     User                     @relation("CalendarInvitationInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy       User?                    @relation("CalendarInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, invitedUserId])
  @@index([invitedUserId, status])
}

model ExternalIntegration {
  id            String              @id @default(cuid())
  provider      IntegrationProvider @unique
  accountEmail  String?
  scopes        String[]
  tokenJson     Json
  connectedById String?
  connectedAt   DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  connectedBy   User?               @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}

model VideoCall {
  id                  String                 @id @default(cuid())
  name                String
  dailyRoomName       String?                @unique
  dailyRoomUrl        String?
  dailyTranscriptId   String?
  createdByUserId     String?
  calendarEventId     String?                @unique
  status              VideoCallStatus        @default(ACTIVE)
  scheduledFor        DateTime?
  startedAt           DateTime               @default(now())
  endedAt             DateTime?
  transcriptText      String?
  transcriptStatus    String                 @default("PENDING")
  transcriptSourceUrl String?
  transcriptFetchedAt DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  createdBy           User?                  @relation("VideoCallCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  calendarEvent       CalendarEvent?         @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  participants        VideoCallParticipant[]

  @@index([status, startedAt])
  @@index([status, scheduledFor])
  @@index([createdByUserId, startedAt])
}

model VideoCallParticipant {
  callId    String
  userId    String
  status    VideoCallParticipantStatus @default(INVITED)
  invitedAt DateTime                   @default(now())
  joinedAt  DateTime?
  leftAt    DateTime?
  call      VideoCall                  @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId, status])
  @@index([callId, status])
}
