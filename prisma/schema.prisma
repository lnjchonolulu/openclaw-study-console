generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARTICIPANT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum FileVisibility {
  PRIVATE
  ROOM
  TEAM
}

enum RoomType {
  PERSONAL
  TEAM
  GROUP
}

enum MessageRole {
  USER
  AGENT
  SYSTEM
}

enum RoomMemberRole {
  OWNER
  MEMBER
}

enum RoomAgentRole {
  PRIMARY
  COLLABORATOR
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  CANCELED
  FAILED
}

enum AgentTaskStatus {
  OPEN
  WAITING
  COMPLETED
  FAILED
  CANCELED
}

enum AgentTaskEventType {
  USER_REQUEST
  AGENT_DECISION
  OUTBOUND_MESSAGE
  SCHEDULED_MESSAGE
  INBOUND_REPLY
  SYSTEM_NOTE
}

enum CalendarEventSource {
  CYWORLD
  GOOGLE
}

enum CalendarInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum IntegrationProvider {
  GOOGLE
}

model User {
  id                     String                       @id @default(cuid())
  username               String                       @unique
  passwordHash           String
  displayName            String
  timezone               String                       @default("Asia/Seoul")
  profileConfigJson      Json?
  role                   UserRole                     @default(PARTICIPANT)
  status                 UserStatus                   @default(ACTIVE)
  teamId                 String?
  agentId                String?                      @unique
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  team                   Team?                        @relation(fields: [teamId], references: [id])
  agent                  Agent?
  files                  FileRecord[]
  messages               Message[]
  sessions               Session[]
  ownedRooms             Room[]                       @relation("RoomOwner")
  roomMembers            RoomMember[]
  typingStates           TypingState[]
  scheduledMessages      ScheduledMessage[]
  requestedTasks         AgentTask[]                  @relation("AgentTaskRequester")
  targetTasks            AgentTask[]                  @relation("AgentTaskTargetUser")
  calendarEvents         CalendarEvent[]              @relation("CalendarEventCreator")
  calendarInvites        CalendarInvitation[]         @relation("CalendarInvitationInvitee")
  sentCalendarInvites    CalendarInvitation[]         @relation("CalendarInvitationInviter")
  calendarTitleOverrides CalendarEventTitleOverride[]
  connectedIntegrations  ExternalIntegration[]
  requestedEmailThreads  EmailThread[]                @relation("EmailThreadRequester")
}

model Team {
  id             String          @id @default(cuid())
  name           String          @unique
  users          User[]
  files          FileRecord[]
  rooms          Room[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Agent {
  id                String             @id @default(cuid())
  userId            String             @unique
  openclawAgentId   String             @unique
  displayName       String
  workspacePath     String
  profileConfigJson Json?
  personaSummary    String?
  soulConfigJson    Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id])
  messages          Message[]
  roomAgents        RoomAgent[]
  scheduledMessages ScheduledMessage[]
  tasks             AgentTask[]
  emailThreads      EmailThread[]
}

model FileRecord {
  id               String         @id @default(cuid())
  ownerUserId      String?
  teamId           String?
  roomId           String?
  parentId         String?
  systemKey        String?        @unique
  filename         String
  storageKey       String
  mimeType         String?
  isFolder         Boolean        @default(false)
  sizeBytes        Int?
  visibility       FileVisibility @default(PRIVATE)
  sourceType       String
  accessConfigJson Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner            User?          @relation(fields: [ownerUserId], references: [id])
  team             Team?          @relation(fields: [teamId], references: [id])
  room             Room?          @relation(fields: [roomId], references: [id])
  parent           FileRecord?    @relation("FileRecordChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children         FileRecord[]   @relation("FileRecordChildren")

  @@index([parentId])
}

model Room {
  id                String             @id @default(cuid())
  type              RoomType
  name              String             @default("Untitled room")
  purpose           String?
  defaultReportMode String             @default("CHANNEL")
  teamId            String?
  ownerUserId       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  team              Team?              @relation(fields: [teamId], references: [id])
  owner             User?              @relation("RoomOwner", fields: [ownerUserId], references: [id])
  messages          Message[]
  files             FileRecord[]
  members           RoomMember[]
  agents            RoomAgent[]
  typingStates      TypingState[]
  scheduledMessages ScheduledMessage[]
  agentTasks        AgentTask[]
  emailThreads      EmailThread[]      @relation("EmailThreadSourceRoom")

  @@index([ownerUserId, type])
  @@index([teamId, type])
}

model Message {
  id               String      @id @default(cuid())
  roomId           String
  userId           String?
  agentId          String?
  taskId           String?
  replyToMessageId String?
  role             MessageRole
  content          String
  createdAt        DateTime    @default(now())
  room             Room        @relation(fields: [roomId], references: [id])
  user             User?       @relation(fields: [userId], references: [id])
  agent            Agent?      @relation(fields: [agentId], references: [openclawAgentId])
  task             AgentTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  replyToMessage   Message?    @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]   @relation("MessageReplies")

  @@index([taskId, createdAt])
  @@index([replyToMessageId])
}

model ScheduledMessage {
  id        String                 @id @default(cuid())
  roomId    String
  agentId   String
  toUserId  String
  taskId    String?
  content   String
  deliverAt DateTime
  status    ScheduledMessageStatus @default(PENDING)
  error     String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  room      Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent     Agent                  @relation(fields: [agentId], references: [openclawAgentId])
  toUser    User                   @relation(fields: [toUserId], references: [id], onDelete: Cascade)
  task      AgentTask?             @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([status, deliverAt])
  @@index([toUserId])
  @@index([agentId])
  @@index([taskId, deliverAt])
}

model AgentTask {
  id                String             @id @default(cuid())
  agentId           String
  requesterUserId   String
  targetUserId      String?
  sourceRoomId      String?
  status            AgentTaskStatus    @default(OPEN)
  kind              String
  title             String
  objective         String
  resultSummary     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  agent             Agent              @relation(fields: [agentId], references: [openclawAgentId], onDelete: Cascade)
  requester         User               @relation("AgentTaskRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  targetUser        User?              @relation("AgentTaskTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  sourceRoom        Room?              @relation(fields: [sourceRoomId], references: [id], onDelete: SetNull)
  messages          Message[]
  scheduledMessages ScheduledMessage[]
  events            AgentTaskEvent[]
  emailThreads      EmailThread[]

  @@index([agentId, status])
  @@index([requesterUserId, status])
  @@index([targetUserId, status])
}

model EmailThread {
  id                 String         @id @default(cuid())
  agentId            String
  requesterUserId    String
  sourceRoomId       String?
  taskId             String?
  gmailThreadId      String         @unique
  lastGmailMessageId String?
  subject            String
  to                 String
  cc                 String?
  status             String         @default("OPEN")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  agent              Agent          @relation(fields: [agentId], references: [openclawAgentId], onDelete: Cascade)
  requester          User           @relation("EmailThreadRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  sourceRoom         Room?          @relation("EmailThreadSourceRoom", fields: [sourceRoomId], references: [id], onDelete: SetNull)
  task               AgentTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  messages           EmailMessage[]

  @@index([agentId, status])
  @@index([requesterUserId, status])
  @@index([sourceRoomId])
  @@index([taskId])
}

model EmailMessage {
  id             String      @id @default(cuid())
  emailThreadId  String
  gmailMessageId String      @unique
  direction      String
  from           String?
  to             String?
  cc             String?
  subject        String?
  snippet        String?
  body           String?
  receivedAt     DateTime?
  payloadJson    Json?
  createdAt      DateTime    @default(now())
  emailThread    EmailThread @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)

  @@index([emailThreadId, createdAt])
}

model AgentTaskEvent {
  id        String             @id @default(cuid())
  taskId    String
  type      AgentTaskEventType
  summary   String
  payload   Json?
  createdAt DateTime           @default(now())
  task      AgentTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model RoomMember {
  roomId          String
  userId          String
  role            RoomMemberRole @default(MEMBER)
  canManageRoom   Boolean        @default(false)
  canManageAgents Boolean        @default(false)
  canShareFiles   Boolean        @default(true)
  lastReadAt      DateTime       @default(now())
  joinedAt        DateTime       @default(now())
  room            Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

model TypingState {
  roomId    String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([expiresAt])
}

model RoomAgent {
  roomId         String
  agentId        String
  role           RoomAgentRole @default(COLLABORATOR)
  roleNote       String?
  canRespond     Boolean       @default(true)
  canUseFiles    Boolean       @default(true)
  canBeMentioned Boolean       @default(true)
  lastSeenMessageId String?
  lastInvokedAt  DateTime?
  lastSpokeAt    DateTime?
  mutedUntil     DateTime?
  joinedAt       DateTime      @default(now())
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([roomId, agentId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id               String                       @id @default(cuid())
  teamId           String?
  createdByUserId  String?
  title            String
  description      String?
  location         String?
  startAt          DateTime
  endAt            DateTime
  allDay           Boolean                      @default(false)
  source           CalendarEventSource          @default(CYWORLD)
  externalProvider String?
  externalEventId  String?
  accessConfigJson Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  team             Team?                        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy        User?                        @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  invitations      CalendarInvitation[]
  titleOverrides   CalendarEventTitleOverride[]

  @@index([teamId, startAt])
  @@index([createdByUserId, startAt])
  @@index([source, externalProvider, externalEventId])
}

model CalendarEventTitleOverride {
  id        String        @id @default(cuid())
  eventId   String
  userId    String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model CalendarInvitation {
  id              String                   @id @default(cuid())
  eventId         String
  invitedUserId   String
  invitedByUserId String?
  status          CalendarInvitationStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  event           CalendarEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedUser     User                     @relation("CalendarInvitationInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy       User?                    @relation("CalendarInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, invitedUserId])
  @@index([invitedUserId, status])
}

model ExternalIntegration {
  id            String              @id @default(cuid())
  provider      IntegrationProvider @unique
  accountEmail  String?
  scopes        String[]
  tokenJson     Json
  connectedById String?
  connectedAt   DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  connectedBy   User?               @relation(fields: [connectedById], references: [id], onDelete: SetNull)
}
