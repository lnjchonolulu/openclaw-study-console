generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARTICIPANT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum FileVisibility {
  PRIVATE
  ROOM
  TEAM
}

enum RoomType {
  PERSONAL
  TEAM
  GROUP
}

enum MessageRole {
  USER
  AGENT
  SYSTEM
}

enum RoomMemberRole {
  OWNER
  MEMBER
}

enum RoomAgentRole {
  PRIMARY
  COLLABORATOR
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  displayName  String
  profileConfigJson Json?
  role         UserRole    @default(PARTICIPANT)
  status       UserStatus  @default(ACTIVE)
  teamId       String?
  agentId      String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  team         Team?       @relation(fields: [teamId], references: [id])
  agent        Agent?
  files        FileRecord[]
  messages     Message[]
  sessions     Session[]
  ownedRooms   Room[]      @relation("RoomOwner")
  roomMembers  RoomMember[]
  typingStates TypingState[]
}

model Team {
  id        String       @id @default(cuid())
  name      String       @unique
  users     User[]
  files     FileRecord[]
  rooms     Room[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Agent {
  id              String   @id @default(cuid())
  userId          String   @unique
  openclawAgentId String   @unique
  displayName     String
  workspacePath   String
  profileConfigJson Json?
  personaSummary  String?
  soulConfigJson  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  messages        Message[]
  roomAgents      RoomAgent[]
}

model FileRecord {
  id          String         @id @default(cuid())
  ownerUserId String?
  teamId      String?
  roomId      String?
  filename    String
  storageKey  String
  mimeType    String?
  visibility  FileVisibility @default(PRIVATE)
  sourceType  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User?          @relation(fields: [ownerUserId], references: [id])
  team        Team?          @relation(fields: [teamId], references: [id])
  room        Room?          @relation(fields: [roomId], references: [id])
}

model Room {
  id           String       @id @default(cuid())
  type         RoomType
  name         String       @default("Untitled room")
  teamId       String?
  ownerUserId  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  team         Team?        @relation(fields: [teamId], references: [id])
  owner        User?        @relation("RoomOwner", fields: [ownerUserId], references: [id])
  messages     Message[]
  files        FileRecord[]
  members      RoomMember[]
  agents       RoomAgent[]
  typingStates TypingState[]

  @@index([ownerUserId, type])
  @@index([teamId, type])
}

model Message {
  id        String      @id @default(cuid())
  roomId    String
  userId    String?
  agentId   String?
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
  room      Room        @relation(fields: [roomId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])
  agent     Agent?      @relation(fields: [agentId], references: [openclawAgentId])
}

model RoomMember {
  roomId          String
  userId          String
  role            RoomMemberRole @default(MEMBER)
  canManageRoom   Boolean        @default(false)
  canManageAgents Boolean        @default(false)
  canShareFiles   Boolean        @default(true)
  lastReadAt      DateTime       @default(now())
  joinedAt        DateTime       @default(now())
  room            Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

model TypingState {
  roomId     String
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([expiresAt])
}

model RoomAgent {
  roomId        String
  agentId       String
  role          RoomAgentRole @default(COLLABORATOR)
  canRespond    Boolean       @default(true)
  canUseFiles   Boolean       @default(true)
  canBeMentioned Boolean      @default(true)
  joinedAt      DateTime      @default(now())
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([roomId, agentId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
