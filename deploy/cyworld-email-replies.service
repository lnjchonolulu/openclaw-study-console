[Unit]
Description=Poll CyWorld shared Gmail replies
After=network.target openclaw-study.service

[Service]
Type=oneshot
WorkingDirectory=/opt/openclaw-study
Environment=NODE_ENV=production
EnvironmentFile=/opt/openclaw-study/.env
ExecStart=/bin/sh -lc 'curl -fsS -X POST -H "Authorization: Bearer $INTERNAL_AGENT_ACTION_TOKEN" http://127.0.0.1:3000/api/internal/email/replies'
User=root
